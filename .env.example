# AI provider keys (fill only providers you plan to use)
GEMINI_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=

# Upload / processing options
MAX_UPLOAD_MB=200
MAX_REFERENCE_FILE_MB=15
YOUTUBE_ENABLED=1
WHISPER_CHUNK_SECONDS=300

# API security and frontend origins
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
SESSION_COOKIE_SECURE=0
AUTH_DB_PATH=auth.sqlite3

# Create or update the bootstrap administrator on server startup.
# Use a real email and a unique password of at least 12 characters.
# For public HTTPS deployment, set SESSION_COOKIE_SECURE=1.
ADMIN_EMAIL=
ADMIN_PASSWORD=
