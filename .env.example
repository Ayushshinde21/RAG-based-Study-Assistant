# AI provider keys (fill only providers you plan to use)
GEMINI_API_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=

# Upload / processing options
MAX_UPLOAD_MB=200
MAX_REFERENCE_FILE_MB=15
MAX_DOCUMENT_FILES=5
MAX_DOCUMENT_FILE_MB=15
MAX_DOCUMENT_TEXT_CHARS=250000
YOUTUBE_ENABLED=1
WHISPER_CHUNK_SECONDS=300
SARVAM_MAX_WORKERS=3

# API security and frontend origins
APP_ENV=development
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
SESSION_COOKIE_SECURE=0
AUTH_DB_PATH=auth.sqlite3

# In-process safeguards (use shared Redis/queue services for multi-instance production)
MAX_ACTIVE_JOBS_PER_USER=2
MAX_ACTIVE_JOBS_TOTAL=12
MAX_RETAINED_JOBS=500
MODEL_REQUEST_RATE_LIMIT=30
MODEL_REQUEST_WINDOW_SECONDS=60
JOB_RETENTION_SECONDS=86400

# Create or update the bootstrap administrator on server startup.
# Use a real email and a unique password of at least 12 characters.
# For public HTTPS deployment, set SESSION_COOKIE_SECURE=1.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Durable database for Cloud Run. Leave DATABASE_BACKEND=auto and DATABASE_URL
# blank for local SQLite. For Cloud SQL Unix sockets, use DB_USER, DB_PASSWORD,
# DB_NAME, and INSTANCE_UNIX_SOCKET instead of putting credentials in a URL.
DATABASE_BACKEND=auto
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
INSTANCE_UNIX_SOCKET=
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Set VECTOR_STORE_BACKEND=postgres only after PostgreSQL has the vector extension.
VECTOR_STORE_BACKEND=chroma
VECTOR_DIMENSIONS=384
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
